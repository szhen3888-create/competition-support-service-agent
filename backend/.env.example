# 应用
APP_NAME=竞赛辅助服务智能体
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM（默认 DeepSeek，可切换任意 OpenAI 兼容 API）
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-your-deepseek-api-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60

# 快速模型（意图分类 / 打分，可与主模型相同）
LLM_FAST_MODEL=deepseek-chat

# 数据库（默认 SQLite，零依赖；可改 MySQL）
DATABASE_URL=sqlite:///./data/competition_agent.db
# DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/competition_agent

# JWT（生产环境请改成随机长串）
JWT_SECRET=competition-agent-dev-secret-change-me
JWT_EXPIRE_HOURS=72

# 知识库
CHROMA_PERSIST_DIR=./data/chroma
KNOWLEDGE_DIR=./data/knowledge
RAG_TOP_K=5
RAG_MAX_REWRITE=2
